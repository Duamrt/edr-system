    "audit_trigger_function": {
      "name": "fn_audit_log",
      "owner": "postgres",
      "config": [
        "search_path=public"
      ],
      "definer": true,
      "definition": "CREATE OR REPLACE FUNCTION public.fn_audit_log()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nDECLARE\r\n  _uid uuid;\r\n  _nome text;\r\n  _cid uuid;\r\n  _rid uuid;\r\nBEGIN\r\n  -- Identificar usuário\r\n  _uid := auth.uid();\r\n  SELECT raw_user_meta_data->>'nome' INTO _nome\r\n    FROM auth.users WHERE id = _uid;\r\n\r\n  -- Determinar registro e company\r\n  IF TG_OP = 'DELETE' THEN\r\n    _rid := OLD.id;\r\n    _cid := OLD.company_id;\r\n  ELSE\r\n    _rid := NEW.id;\r\n    _cid := NEW.company_id;\r\n  END IF;\r\n\r\n  INSERT INTO audit_logs (tabela, operacao, registro_id, dados_antes, dados_depois, usuario_id, usuario_nome, company_id)\r\n  VALUES (\r\n    TG_TABLE_NAME,\r\n    TG_OP,\r\n    _rid,\r\n    CASE WHEN TG_OP IN ('UPDATE','DELETE') THEN to_jsonb(OLD) ELSE NULL END,\r\n    CASE WHEN TG_OP IN ('INSERT','UPDATE') THEN to_jsonb(NEW) ELSE NULL END,\r\n    _uid,\r\n    _nome,\r\n    _cid\r\n  );\r\n\r\n  IF TG_OP = 'DELETE' THEN RETURN OLD; ELSE RETURN NEW; END IF;\r\nEND;\r\n$function$\n"
    },
